# Copy this file to .env and adjust values as needed.
# .env itself is gitignored and must never be committed.

APP_NAME=RecoverAI API
APP_ENV=development

# Comma-separated list of allowed frontend origins (Vite dev server default: 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB connection (Stage 2).
# Leave MONGODB_URI empty to run without a database — the app still starts,
# and GET /api/db/health will report { "connected": false }.
# Example local URI: mongodb://localhost:27017
# Example Atlas URI: mongodb+srv://<user>:<password>@<cluster>/<db>
MONGODB_URI=
MONGODB_DB_NAME=recoverai

# --- Reserved for a future stage, not used yet ---
# LLM API key for the recovery agent / AI assistant
LLM_API_KEY=